# Documentation template only: the Electron main process does not load this
# file automatically. Export these variables in your shell before launching.
# Empty MIST_DATA_DIR uses the platform's normal application-data directory.
MIST_DATA_DIR=
# Use 1 for an isolated development profile that must not migrate old notes.
MIST_SKIP_MIGRATION=0
# DeepSeek API keys are entered in the app and encrypted by the OS.
# They are deliberately NOT configured through renderer environment variables.
